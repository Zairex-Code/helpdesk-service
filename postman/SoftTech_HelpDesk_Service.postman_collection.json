              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Excellent support before the payroll cutoff!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tickets/{{ticket_id}}/close",
              "host": [
