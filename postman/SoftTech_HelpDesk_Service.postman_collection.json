              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolutionNotes\": \"Adjusted isolation level and optimized batch chunking size in the payroll transaction manager.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tickets/{{ticket_id}}/resolve",
              "host": [
